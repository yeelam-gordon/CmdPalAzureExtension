<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="DevHome.nuget.internal" value="https://microsoft.pkgs.visualstudio.com/Dart/_packaging/DevHome.nuget.internal/nuget/v3/index.json" />
    <add key="PowerToysPublicDependencies" value="https://pkgs.dev.azure.com/shine-oss/PowerToys/_packaging/PowerToysPublicDependencies/nuget/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="DevHome.nuget.internal">
      <package pattern="*" />
    </packageSource>
    <packageSource key="PowerToysPublicDependencies">
      <package pattern="MSTest" />
      <package pattern="MSTest.*" />
      <package pattern="System.Security.Cryptography.Xml" />
    </packageSource>
  </packageSourceMapping>
</configuration>
